# .env - Configuración de variables de entorno
# IMPORTANTE: No subir este archivo a control de versiones (Git)

# Clave secreta para sesiones (genera una clave única y segura)
SECRET_KEY= cambia-esto

# Configuración de correo electrónico
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Si usas otro proveedor de correo, cambia estas configuraciones:
# Para Outlook/Hotmail:
# MAIL_SERVER=smtp-mail.outlook.com
# MAIL_PORT=587

# Para Yahoo:
# MAIL_SERVER=smtp.mail.yahoo.com
# MAIL_PORT=587